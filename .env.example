# ---------------------------------------------------------------------------
# Copy to `.env` and adjust. Nothing in the codebase hardcodes any value here.
#
# This one file is read by BOTH docker-compose.yml (via ${VAR} substitution)
# and the application (via pydantic-settings in src/kedra_scraper/config.py).
# That is deliberate: the port Mongo binds to and the port the app dials are
# the same variable, so they cannot drift apart.
#
# `.env` is gitignored. `.env.example` is committed and is the documentation.
# ---------------------------------------------------------------------------

# --- MongoDB ---------------------------------------------------------------
# These same credentials initialise the container (docker-compose.yml) and
# authenticate the application (config.py), so they cannot disagree.
MONGO_USERNAME=kedra
MONGO_PASSWORD=kedra_local_dev
MONGO_HOST=localhost
MONGO_DB=wrc
MONGO_AUTH_SOURCE=admin

# Host-side port. If something already occupies 27017 on your machine (a locally
# installed MongoDB is the usual culprit), change this in your own `.env` -- the
# container keeps listening on 27017 internally either way, and the application
# builds its connection string from this value, so nothing else needs touching.
MONGO_PORT=27017

# --- MinIO / S3 ------------------------------------------------------------
MINIO_ROOT_USER=kedra
MINIO_ROOT_PASSWORD=kedra_local_dev
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# The app talks to MinIO through the ordinary S3 API. Point S3_ENDPOINT_URL at
# real AWS (or unset it) and the same boto3 code runs unchanged -- that is the
# entire reason for choosing MinIO over a MinIO-specific client.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=kedra
S3_SECRET_KEY=kedra_local_dev
S3_REGION=us-east-1

LANDING_BUCKET=wrc-landing
CURATED_BUCKET=wrc-curated

# --- mongo-express (inspection UI only, not used by the pipeline) ----------
MONGO_EXPRESS_PORT=8081

# --- Scraper politeness ----------------------------------------------------
# Requirement 1 asks for "the fastest way without getting blocked". AutoThrottle
# adapts the delay to observed latency instead of a fixed sleep; the values below
# are the ceiling it is allowed to reach, not a constant rate.
SCRAPER_CONCURRENT_REQUESTS=8
SCRAPER_AUTOTHROTTLE_TARGET_CONCURRENCY=4.0
SCRAPER_DOWNLOAD_TIMEOUT=60
SCRAPER_RETRY_TIMES=3
SCRAPER_ROBOTSTXT_OBEY=true

# A contactable UA is part of scraping politely; a site operator who wants us to
# stop should not have to guess who we are. See ARCHITECTURE.md on robots.txt.
SCRAPER_USER_AGENT=kedra-scraper/0.1 (+https://github.com/ralphyared/kedra-scraper)

# Caches HTTP responses on disk so re-running during development does not
# re-hit the site. Should be false for the real demo run.
SCRAPER_HTTPCACHE_ENABLED=false

# --- Partitioning ----------------------------------------------------------
# month | week | day. See ARCHITECTURE.md for why month is the default.
PARTITION_GRANULARITY=month

# --- Orchestration ---------------------------------------------------------
# Bounds of the Dagster monthly partition grid, end-exclusive. The default is
# Q1 2024, which across the four bodies is the 12-partition backfill used as the
# demo: 895 records, inside the brief's 500-1000 evaluation band.
PARTITION_WINDOW_START=2024-01-01
PARTITION_WINDOW_END=2024-04-01

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs
